# Copy this file to .env and adjust as needed.
# All variables are prefixed FMA_ (Facial Mood Analysis) and map 1:1
# onto app/core/config.py:Settings. Never commit the real .env file.

FMA_ENVIRONMENT=development
FMA_LOG_LEVEL=INFO

FMA_API_HOST=0.0.0.0
FMA_API_PORT=8000

# --- Camera (Phase 2) ---
FMA_CAMERA_INDEX=0
FMA_CAMERA_WIDTH=640
FMA_CAMERA_HEIGHT=480
FMA_CAMERA_TARGET_FPS=30

# --- Face detection (Phase 2) ---
FMA_FACE_DETECTOR_BACKEND=opencv_haar
FMA_FACE_MIN_CONFIDENCE=0.5

# --- Representations / DIP params (Phase 3) ---
FMA_ENABLE_GRAYSCALE=true
FMA_ENABLE_CLAHE=true
FMA_ENABLE_CANNY=true
FMA_ENABLE_SOBEL=true
FMA_ENABLE_LBP=true

FMA_CLAHE_CLIP_LIMIT=2.0
FMA_CLAHE_TILE_GRID_SIZE=8

FMA_CANNY_LOW_THRESHOLD=100
FMA_CANNY_HIGH_THRESHOLD=200
FMA_CANNY_APERTURE_SIZE=3
FMA_CANNY_L2_GRADIENT=false

FMA_SOBEL_KERNEL_SIZE=3
FMA_SOBEL_SCALE=1.0
FMA_SOBEL_DELTA=0.0

FMA_LBP_RADIUS=1
FMA_LBP_N_POINTS=8
FMA_LBP_NUM_BINS=10
FMA_LBP_METHOD=uniform

FMA_REPRESENTATION_DEBUG_DIR=outputs/representations

# --- Fusion model (Phase 6) ---
FMA_FUSION_MODEL_PATH=models/fusion_model.pkl
FMA_FUSION_SCALER_PATH=models/scaler.pkl

# --- Temporal smoothing (Phase 8) ---
# Initial engineering defaults (Phase 8 spec sec 31/32) -- not
# experimentally optimized. See Phase 9 for ablation over these.
FMA_TEMPORAL_ENABLED=true
FMA_SMOOTHING_METHOD=moving_average
FMA_SMOOTHING_WINDOW_SIZE=5
FMA_EMA_ALPHA=0.3
FMA_MAX_MISSING_FACE_FRAMES=15
FMA_FACE_CONTINUITY_IOU_THRESHOLD=0.2

# --- Quality control (Phase 8) ---
FMA_QUALITY_ENABLED=true
FMA_QUALITY_MODE=advisory
FMA_MIN_FACE_AREA_RATIO=0.05
FMA_MIN_BRIGHTNESS=40.0
FMA_MAX_BRIGHTNESS=220.0
FMA_MIN_SHARPNESS=60.0
FMA_MIN_CONTRAST=20.0

# --- FER2013 dataset / feature-dataset generation (Phase 5) ---
FMA_DATASET_NAME=FER2013
FMA_DATASET_PATH=dataset/fer2013.csv
FMA_FEATURES_DIR=features
FMA_DATASET_FAILURES_PATH=outputs/dataset_failures.csv
FMA_DATASET_SUMMARY_PATH=outputs/dataset_summary.txt
FMA_DATASET_SPLIT_SEED=42
FMA_DATASET_TRAIN_RATIO=0.8
FMA_DATASET_VAL_RATIO=0.1
FMA_DATASET_TEST_RATIO=0.1
FMA_DATASET_CHECKPOINT_BATCH_SIZE=200
FMA_DATASET_PROGRESS_LOG_EVERY=250

# Browser frontend origins. Use JSON list syntax for pydantic-settings.
FMA_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Real-data FER2013 emotion probability provider used by the packaged model
FMA_FER2013_LINEAR_EMOTION_MODEL_PATH=models/fer2013_emotion_linear.joblib
